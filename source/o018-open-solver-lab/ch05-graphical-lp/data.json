{
  "authority_facts": [
    {
      "id": "fact.ch05.ex05-10-pinned-rhs-repair",
      "description_id": "Authority tersemat sudah memakai ruas kanan 0,40 untuk zat gizi M dan 0,30 untuk zat gizi N. Laboratorium mempertahankannya sebagai fakta authority, bukan koreksi baru.",
      "status": "present_in_pinned_authority"
    },
    {
      "id": "fact.ch05.ex05-16-pinned-direction-repair",
      "description_id": "Authority tersemat sudah memakai arah (2,1) dari titik (0,6). Laboratorium mempertahankannya sebagai fakta authority, bukan koreksi baru.",
      "status": "present_in_pinned_authority"
    }
  ],
  "content_license": "CC-BY-SA-4.0",
  "divergences": [
    {
      "id": "div.ch05.furniture-inactive-bound",
      "authority_behavior": "Uraian contoh bengkel menyebut batas tak aktif x1 <= 35, sedangkan model dan geometri contoh asal memakai x1 <= 32.",
      "target_resolution": "Edisi Indonesia menyelaraskan uraian contoh asal dengan batas x1 <= 32; laboratorium tidak mengubah koefisien model latihan mana pun.",
      "status": "target_corrected"
    },
    {
      "id": "div.ch05.furniture-alt-bound-change",
      "authority_behavior": "Contoh tujuan alternatif menyatakan kendala tidak berubah, tetapi modelnya menaikkan batas x1 dari 32 menjadi 35 dan geometri optimalnya bergantung pada kenaikan itu.",
      "target_resolution": "Edisi Indonesia menyatakan perubahan batas 32 menjadi 35 secara eksplisit.",
      "status": "target_corrected"
    },
    {
      "id": "div.ch05.gradient-versus-level-curve",
      "authority_behavior": "Authority menyebut gradien (2,1) sejajar dengan garis kendala 2x1+x2=80; gradien sebenarnya normal terhadap garis itu, sedangkan kurva arasnya sejajar.",
      "target_resolution": "Edisi Indonesia menyebut gradien sebagai vektor normal dan kurva aras sebagai garis yang sejajar dengan batas kendala.",
      "status": "target_corrected"
    },
    {
      "id": "div.ch05.unbounded-example-ray-start",
      "authority_behavior": "Authority mengklaim (n,0) layak untuk semua bilangan bulat n mulai dari 1, padahal x1+3x2>=6 mensyaratkan n>=6.",
      "target_resolution": "Edisi Indonesia dan sertifikat laboratorium memakai n>=6.",
      "status": "target_corrected"
    },
    {
      "id": "div.ch05.ex05-07-selected-solution-envelope",
      "authority_behavior": "Solusi terpilih menulis min{2+y/2, 1-2y}, walaupun kedua pertidaksamaan mewajibkan z berada di atas keduanya sehingga selubung yang diminimumkan ialah max{2+y/2, 1-2y}.",
      "target_resolution": "Edisi Indonesia memakai min_y max{2+y/2, 1-2y}; optimum 9/5 tidak berubah.",
      "status": "target_corrected"
    },
    {
      "id": "div.ch05.ex05-08-manual-constraint",
      "authority_behavior": "Latihan 5.8 menetapkan x+3y>=3, sementara perhitungan prosa manual menuliskan t+0=t>=3 pada sinar y=0 dan dengan demikian tidak memperlihatkan faktor 3.",
      "target_resolution": "Model laboratorium terikat pada pertidaksamaan latihan x+3y>=3. Sinar (t,0), t>=3 tetap sah untuk model itu; tidak ada koefisien yang diganti diam-diam.",
      "status": "preserved_and_disclosed"
    },
    {
      "id": "div.ch05.ex05-09-title-objective",
      "authority_behavior": "Judul latihan mengisyaratkan solusi berhingga pada daerah tak berbatas, tetapi objektif max(-2x1+x2) tak berbatas di sepanjang (0,2)+t(0,1).",
      "target_resolution": "Edisi Indonesia memakai judul netral 'Berhingga atau Tak Berbatas?' sambil mempertahankan objektif; hasil laboratorium secara eksplisit mengklasifikasikan model sebagaimana tertulis sebagai tak berbatas.",
      "status": "target_corrected_and_disclosed"
    },
    {
      "id": "div.ch05.closing-figure-accessibility",
      "authority_behavior": "Lima keterangan gambar kerucut/arah ekstrem pada baris authority 1194, 1220, 1256, 1274, dan 1296 terpotong; salah satunya juga memakai istilah warna yang tidak sesuai isi gambar.",
      "target_resolution": "Edisi Indonesia melengkapi keterangan hanya dari geometri TikZ yang dipertahankan dan memakai deskripsi biru-sian yang sesuai; plot SVG laboratorium memiliki title, desc, dan uraian terstruktur sendiri.",
      "status": "target_accessibility_corrected"
    }
  ],
