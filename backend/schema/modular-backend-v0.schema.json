{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.interlanguage.local/modular-backend/modular-backend-v0.schema.json",
  "title": "Locale-neutral modular translation backend v0",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "snapshot_at",
    "programs",
    "courses",
    "resources",
    "editions",
    "units",
    "concepts",
    "segments",
    "terms",
    "assets",
    "relations",
    "rights",
    "corrections",
    "qa_events",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "interlanguage.modular-backend"},
    "schema_version": {"const": "0.1.0"},
    "snapshot_at": {"type": "string", "minLength": 1},
    "programs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/program"}]}},
    "courses": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/course"}]}},
    "resources": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/resource"}]}},
    "editions": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/edition"}]}},
    "units": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/unit"}]}},
    "concepts": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/concept"}]}},
    "segments": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/segment"}]}},
    "terms": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/term"}]}},
    "assets": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/asset"}]}},
    "relations": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/relation"}]}},
    "rights": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/right"}]}},
    "corrections": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/correction"}]}},
    "qa_events": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/qa_event"}]}},
    "artifacts": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entity"}, {"$ref": "#/$defs/artifact"}]}}
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "schema_name",
        "schema_version",
        "id",
        "status",
        "recorded_at",
        "responsible_workflow",
        "supersedes_id"
      ],
      "properties": {
        "schema_name": {"type": "string", "minLength": 1},
        "schema_version": {"const": "0.1.0"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
        "status": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "minLength": 1},
        "responsible_workflow": {"type": "string", "minLength": 1},
        "supersedes_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      },
      "additionalProperties": true
    },
    "id_array": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}
    },
    "string_array": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nullable_string": {
      "anyOf": [{"type": "null"}, {"type": "string"}]
    },
    "nullable_integer": {
      "anyOf": [{"type": "null"}, {"type": "integer"}]
    },
    "nullable_sha256": {
      "anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]
    },
    "program": {
      "type": "object",
      "required": ["title", "language", "locale", "version"],
      "properties": {
        "schema_name": {"const": "interlanguage.program"},
        "title": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "course": {
      "type": "object",
      "required": ["program_id", "resource_ids", "prerequisite_course_ids", "curriculum_role", "prerequisite_note"],
      "properties": {
        "schema_name": {"const": "interlanguage.course"},
        "program_id": {"type": "string", "minLength": 1},
        "resource_ids": {"$ref": "#/$defs/id_array"},
        "prerequisite_course_ids": {"$ref": "#/$defs/id_array"},
        "curriculum_role": {"type": "string", "minLength": 1},
        "prerequisite_note": {"type": "string"}
      }
    },
    "resource": {
      "type": "object",
      "required": ["title", "creator", "resource_type", "rights_component_ids"],
      "properties": {
        "schema_name": {"const": "interlanguage.resource"},
        "title": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "resource_type": {"type": "string", "minLength": 1},
        "rights_component_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "edition": {
      "type": "object",
      "required": ["resource_id", "language", "locale"],
      "properties": {
        "schema_name": {"const": "interlanguage.edition"},
        "resource_id": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1}
      }
    },
    "unit": {
      "type": "object",
      "required": ["unit_type", "resource_id", "edition_id", "parent_id", "order", "locale", "translation_state", "rights_component_id", "topology_path", "topology_order_path"],
      "properties": {
        "schema_name": {"const": "interlanguage.unit"},
        "unit_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "edition_id": {"type": "string", "minLength": 1},
        "parent_id": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "order": {"type": "integer"},
        "locale": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "translation_state": {"type": "string", "minLength": 1},
        "rights_component_id": {"type": "string", "minLength": 1},
        "topology_path": {"$ref": "#/$defs/id_array"},
        "topology_order_path": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "concept": {
      "type": "object",
      "required": ["name_en", "prerequisite_concept_ids"],
      "properties": {
        "schema_name": {"const": "interlanguage.concept"},
        "name_en": {"type": "string", "minLength": 1},
        "prerequisite_concept_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "segment": {
      "type": "object",
      "required": ["unit_id", "parent_id", "order", "segment_type", "resource_id", "source_edition_id", "target_edition_id", "source_path", "source_local_id", "source_locale", "target_locale", "locale", "target_text", "target_content_sha256", "translation_state", "source_target_relationship", "provenance", "concept_ids", "prerequisite_concept_ids", "rights_component_id", "asset_refs", "asset_ids", "code_data_refs", "external_refs", "topology_path", "topology_order_path"],
      "properties": {
        "schema_name": {"const": "interlanguage.segment"},
        "unit_id": {"type": "string", "minLength": 1},
        "parent_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer"},
        "segment_type": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "minLength": 1},
        "source_edition_id": {"$ref": "#/$defs/nullable_string"},
        "target_edition_id": {"$ref": "#/$defs/nullable_string"},
        "source_path": {"$ref": "#/$defs/nullable_string"},
        "source_local_id": {"$ref": "#/$defs/nullable_string"},
        "source_locale": {"$ref": "#/$defs/nullable_string"},
        "target_locale": {"$ref": "#/$defs/nullable_string"},
        "locale": {"$ref": "#/$defs/nullable_string"},
        "target_text": {"$ref": "#/$defs/nullable_string"},
        "target_content_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "translation_state": {"type": "string", "minLength": 1},
        "source_target_relationship": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "concept_ids": {"$ref": "#/$defs/id_array"},
        "prerequisite_concept_ids": {"$ref": "#/$defs/id_array"},
        "rights_component_id": {"type": "string", "minLength": 1},
        "asset_refs": {"$ref": "#/$defs/string_array"},
        "asset_ids": {"$ref": "#/$defs/id_array"},
        "code_data_refs": {"$ref": "#/$defs/string_array"},
        "external_refs": {"$ref": "#/$defs/string_array"},
        "topology_path": {"$ref": "#/$defs/id_array"},
        "topology_order_path": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "term": {
      "type": "object",
      "required": ["concept_id", "source_locale", "source_term", "target_locale", "preferred", "variants", "rejected", "scope", "register", "evidence"],
      "properties": {
        "schema_name": {"const": "interlanguage.term"},
        "concept_id": {"type": "string", "minLength": 1},
        "source_locale": {"type": "string", "minLength": 1},
        "source_term": {"type": "string", "minLength": 1},
        "target_locale": {"type": "string", "minLength": 1},
        "preferred": {"type": "string", "minLength": 1},
        "variants": {"$ref": "#/$defs/string_array"},
        "rejected": {"$ref": "#/$defs/string_array"},
        "scope": {"type": "string", "minLength": 1},
        "register": {"type": "string", "minLength": 1},
        "evidence": {}
      }
    },
    "asset": {
      "type": "object",
      "required": ["asset_type", "rights_component_id"],
      "properties": {
        "schema_name": {"const": "interlanguage.asset"},
        "asset_type": {"type": "string", "minLength": 1},
        "rights_component_id": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/nullable_string"},
        "target_path": {"$ref": "#/$defs/nullable_string"},
        "source_content_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "target_content_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "relation": {
      "type": "object",
      "required": ["relation_type", "from_id", "to_id"],
      "properties": {
        "schema_name": {"const": "interlanguage.relation"},
        "relation_type": {"type": "string", "minLength": 1},
        "from_id": {"type": "string", "minLength": 1},
        "to_id": {"type": "string", "minLength": 1}
      }
    },
    "right": {
      "type": "object",
      "required": ["component_scope", "license_expression", "attribution_required", "share_alike_required", "changes_disclosed", "non_endorsement", "third_party_status"],
      "properties": {
        "schema_name": {"const": "interlanguage.right"},
        "component_scope": {"type": "string", "minLength": 1},
        "license_expression": {"type": "string", "minLength": 1},
        "attribution_required": {"anyOf": [{"type": "null"}, {"type": "boolean"}]},
        "share_alike_required": {"anyOf": [{"type": "null"}, {"type": "boolean"}]},
        "changes_disclosed": {"type": "boolean"},
        "non_endorsement": {"type": "boolean"},
        "third_party_status": {"type": "string", "minLength": 1}
      }
    },
    "correction": {
      "type": "object",
      "required": ["correction_type", "affected_unit_ids", "source_defect", "target_action", "rationale", "evidence", "upstream_report_disposition"],
      "properties": {
        "schema_name": {"const": "interlanguage.correction"},
        "correction_type": {"type": "string", "minLength": 1},
        "affected_unit_ids": {"$ref": "#/$defs/id_array"},
        "source_defect": {},
        "target_action": {},
        "rationale": {},
        "evidence": {},
        "upstream_report_disposition": {"type": "string", "minLength": 1}
      }
    },
    "qa_event": {
      "type": "object",
      "required": ["qa_type", "result", "witness", "affected_ids"],
      "properties": {
        "schema_name": {"const": "interlanguage.qa_event"},
        "qa_type": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "witness": {},
        "affected_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_type", "path", "bytes", "sha256", "toolchain", "build_receipt"],
      "properties": {
        "schema_name": {"const": "interlanguage.artifact"},
        "artifact_type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"$ref": "#/$defs/nullable_integer"},
        "sha256": {"$ref": "#/$defs/nullable_sha256"},
        "toolchain": {"type": "string", "minLength": 1},
        "build_receipt": {"type": "string", "minLength": 1}
      }
    }
  }
}
